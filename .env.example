# ==========================================
# Ignite Election Portal - Environment Template
# ==========================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-nextauth-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=ignite-ai-7d7de
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ignite-ai-7d7de.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_ID=your-firebase-client-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Firebase Public / Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ignite-ai-7d7de.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ignite-ai-7d7de
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ignite-ai-7d7de.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
